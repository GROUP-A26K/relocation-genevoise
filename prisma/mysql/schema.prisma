generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model contact {
  id         Int      @id @default(autoincrement())
  first_name String   @db.VarChar(60)
  last_name  String   @db.VarChar(60)
  email      String   @db.VarChar(255)
  phone      String  @db.VarChar(15)
  company    String?  @db.VarChar(255)
  subject    String   @db.VarChar(255)
  message    String?  @db.LongText
  accept     Boolean
  created_at DateTime @db.DateTime(0)
}

model booking {
  id         Int      @id @default(autoincrement())
  phone      String  @db.VarChar(15)
  accept     Boolean
  contact_via String   @db.VarChar(255)
  created_at DateTime @db.DateTime(0)
}

model subscribe {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255) 
  created_at DateTime @db.DateTime(0)
}

model application {
  id               Int      @id @default(autoincrement())
  first_name       String   @db.VarChar(60)
  last_name        String   @db.VarChar(60)
  email            String   @db.VarChar(255)
  phone            String   @db.VarChar(15)
  experience_years String   @db.VarChar(255)
  expected_ctc     Decimal? @db.Decimal(12, 2)
  resume_url       String   @db.VarChar(512)
  department       String   @db.VarChar(255)
  position         String   @db.VarChar(255)
  accept           Boolean
  created_at       DateTime @db.DateTime(0)
}

model landlord_inquiry {
  id               Int      @id @default(autoincrement())
  full_name        String   @db.VarChar(100)
  email            String   @db.VarChar(255)
  phone            String   @db.VarChar(15)
  property_address String   @db.VarChar(255)
  property_type    String   @db.VarChar(50)
  number_of_rooms  String   @db.VarChar(20)
  additional_info  String?  @db.LongText
  accept           Boolean
  created_at       DateTime @db.DateTime(0)
}

model tenant_inquiry {
  id               Int      @id @default(autoincrement())
  full_name        String   @db.VarChar(100)
  email            String   @db.VarChar(255)
  phone            String   @db.VarChar(15)
  property_address String   @db.VarChar(255)
  property_type    String   @db.VarChar(50)
  number_of_rooms  String   @db.VarChar(20)
  accept           Boolean
  created_at       DateTime @db.DateTime(0)
}
