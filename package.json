{
  "name": "gg-boilerplate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-staged": "lint-staged",
    "prisma:generate": "npm run prisma:generate:mysql && npm run prisma:generate:supabase",
    "prisma:generate:mysql": "prisma generate --schema=./prisma/mysql/schema.prisma",
    "prisma:generate:supabase": "prisma generate --schema=./prisma/supabase/schema.prisma",
    "email": "email dev --dir src/templates/Email",
    "typegen": "sanity schema extract --path=src/sanity/extract.json && sanity typegen generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^4.1.3",
    "@next/third-parties": "^16.2.6",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.22.0",
    "@sentry/nextjs": "^10.55.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hamburger-react": "^2.5.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.43.0",
    "media-chrome": "^4.19.0",
    "minio": "^8.0.7",
    "motion": "^12.43.0",
    "next": "^15.5.25",
    "next-intl": "^3.26.5",
    "next-sanity": "^10.1.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.8.9",
    "react": "^19.2.6",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.6",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.76.1",
    "react-intersection-observer": "^10.0.3",
    "react-phone-number-input": "^3.4.16",
    "resend": "^4.8.0",
    "sanity": "^4.22.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.5",
    "@react-email/ui": "^6.9.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "react-email": "^6.6.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "@sanity/uuid": "^3.0.3",
    "deepmerge-ts": "^8.0.2",
    "postcss": "$postcss"
  }
}
